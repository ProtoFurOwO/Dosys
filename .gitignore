/.jdk/
/local.properties
/.idea
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Project exclude paths
/app/build/
/app/build/intermediates/javac/debug/compileDebugJavaWithJavac/classes/

# Firebase: la configuración del proyecto y la cuenta de servicio son secretas.
/app/google-services.json
/backend/secrets/*
!/backend/secrets/.gitkeep

# Backend: secretos y artefactos locales nunca se suben al repositorio.
/backend/.env
/backend/.venv/
/backend/.pytest_cache/
/backend/**/__pycache__/
/backend/**/*.py[cod]
