# Copia este archivo como .env. Nunca subas .env al repositorio.
APP_ENV=development
DOCS_ENABLED=true
POSTGRES_DB=dosys
POSTGRES_USER=dosys
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_LOCAL
JWT_SECRET_KEY=GENERA_UN_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://10.0.2.2

# Transferencia de sesión entre dispositivos (app del paciente).
DEVICE_TRANSFER_TTL_SECONDS=120
DEVICE_TRANSFER_MAX_CODE_SUBMISSIONS=3
DEVICE_TRANSFER_MAX_PER_HOUR=5
# Firebase Cloud Messaging (opcional): sin archivo, el envío queda simulado
# y la app sigue funcionando con el sondeo en primer plano.
FCM_CREDENTIALS_FILE=

# Resumen del expediente con IA (desactivado por defecto).
# AI_PROVIDER=local genera el resumen en el servidor con reglas (sin red ni llave):
# agrupa diagnósticos, ordena eventos, lee PDF de resultados y marca inconsistencias.
# AI_PROVIDER=anthropic usa un proveedor externo (requiere llave e internet).
# La llave va SOLO aquí y nunca al repositorio.
AI_ENABLED=false
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_REQUESTS_PER_USER_HOUR=10

# Lectura local de los PDF de resultados: primero la capa de texto y, si el PDF
# está escaneado, OCR con Tesseract. Opcional.
AI_OCR_ENABLED=false
AI_OCR_MAX_DOCUMENTS=5
AI_OCR_MAX_CHARS_PER_DOCUMENT=4000
AI_OCR_LANGUAGE=spa
# Ruta al binario de Tesseract si no está en el PATH (por ejemplo en Windows).
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Documentos clínicos: los archivos viven en un volumen Docker.
DOCUMENTS_MAX_MB=10
# Opcional: clave propia para el sello de integridad (si se omite, se usa JWT_SECRET_KEY).
# DOCUMENTS_SIGNING_KEY=
