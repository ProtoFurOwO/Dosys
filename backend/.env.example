# Copia este archivo como .env. Nunca subas .env al repositorio.
APP_ENV=development
# En producción debe ser false. En local puedes dejarlo en true para ver /docs.
DOCS_ENABLED=true
POSTGRES_DB=dosys
POSTGRES_USER=dosys
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_LOCAL
JWT_SECRET_KEY=GENERA_UN_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://10.0.2.2

# Transferencia de sesión entre dispositivos (app del paciente).
DEVICE_TRANSFER_TTL_SECONDS=120
DEVICE_TRANSFER_MAX_CODE_SUBMISSIONS=3
DEVICE_TRANSFER_MAX_PER_HOUR=5
# Firebase Cloud Messaging (opcional): sin archivo, el envío queda simulado
# y la app sigue funcionando con el sondeo en primer plano.
FCM_CREDENTIALS_FILE=

# Documentos clínicos: los archivos viven en un volumen Docker.
DOCUMENTS_MAX_MB=10
# Opcional: clave propia para el sello de integridad (si se omite, se usa JWT_SECRET_KEY).
# DOCUMENTS_SIGNING_KEY=

# Máximo de teléfonos autorizados por paciente.
MAX_TRUSTED_DEVICES=3
